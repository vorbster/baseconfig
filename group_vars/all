# Homebrew

brew_packages: 
  - neovim
  - font-hack-nerd-font
  - wget
  - node
  - lua  
  - tmux
  - fzf
  - bat
  - delta
  - eza
  - epk/epk/font-sf-mono-nerd-font
  - alacritty

# MacPorts

macports_url: https://github.com/macports/macports-base/releases/download/v2.8.0/MacPorts-2.8.0-13-Ventura.pkg
macports_filename: "{{ macports_url | basename }}" 
macports_ports:
  - mc
  - elinks  
  - tree

# Linux packages

rpm_packages: 
   - "@Development tools"
   - ruby
   - zsh
   - util-linux-user
   - clang

nvim_git: "git@gitlab.com:vorbster/nvim-config.git"  
tmux_git_repos:
 - "https://github.com/jimeh/tmux-themepack.git"
 - "https://github.com/tmux-plugins/tpm.git"
 - "https://github.com/christoomey/vim-tmux-navigator.git"

macos_defaults:
 - {domain: NSGlobalDomain, key: ApplePressAndHoldEnabled, type: bool, value: false} 

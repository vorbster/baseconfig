# Homebrew

brew_packages: 
  - neovim
  - wget
  - node
  - lua  
  - tmux
  - fd
  - fzf
  - bat
  - eza
  - ansible-lint

brew_packages_mac: []

brew_packages_linux: []

brew_casks:
  - font-jetbrains-mono-nerd-font
  - font-droid-sans-mono-nerd-font
  - font-sauce-code-pro-nerd-font

brew_casks_linux: []

brew_casks_mac:
  - alacritty

# MacPorts

macports_url: https://github.com/macports/macports-base/releases/download/v2.10.2/MacPorts-2.10.2-15-Sequoia.pkg
macports_filename: "{{ macports_url | basename }}" 
macports_ports:
  - mc
  - elinks  
  - tree

# Linux packages

rpm_packages: 
   - "@Development tools"
   - ruby
   - zsh
   - util-linux-user
   - clang

nvim_git: "git@gitlab.com:vorbster/nvim-config.git"  
tmux_git_repos:
 - "https://github.com/jimeh/tmux-themepack.git"
 - "https://github.com/tmux-plugins/tpm.git"
 - "https://github.com/christoomey/vim-tmux-navigator.git"

macos_defaults:
 - {domain: NSGlobalDomain, key: ApplePressAndHoldEnabled, type: bool, value: false} 

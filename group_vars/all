# Homebrew

brew_packages: 
  - wget
  - node
  - lua  
  - octave  
  - tmux

# MacPorts

macports_url: https://github.com/macports/macports-base/releases/download/v2.8.0/MacPorts-2.8.0-13-Ventura.pkg
macports_filename: "{{ macports_url | basename }}" 
macports_ports:
  - mc
  - elinks  
  - neovim
  - tree

ssh_public_key: "{{ lookup('file', 'ssh_public_key')}}"
ssh_private_key: "{{ lookup('file', 'ssh_private_key')}}"
nvim_git: "git@gitlab.com:vorbster/nvim-config.git"  
